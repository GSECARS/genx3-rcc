#SBATCH --job-name=foo
#SBATCH --output=foo.out
#SBATCH --error=foo.err
#SBATCH --time=00:05:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=2
##SBATCH --mem-per-cpu=500
#SBATCH --constraint=ib
##SBATCH --mail-type=BEGIN,END,FAIL

# Load required modules
module load python/${anaconda_module}
module load ${gcc_module}

echo "job started at `date`"
echo "-----------------------"

# Run GenX3 using the environment's own Python binary directly.
# This avoids any ambiguity from conda activate picking up the wrong Python.
mpirun ${python_bin} -m genx.run --mpi --mgen=10000 --km=0.8 --kr=0.6 --error /path/to/input.hgx /path/to/output.hgx

echo "-----------------------"
echo "job finished at `date`"

